      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(outbox_publish_wait_seconds_sum{application=\"slot-service\",type=~\"SlotHeld|SlotHoldFailed|SlotBooked|SlotBookFailed\"}[$__range])) / sum(increase(outbox_publish_wait_seconds_count{application=\"slot-service\",type=~\"SlotHeld|SlotHoldFailed|SlotBooked|SlotBookFailed\"}[$__range]))) / (sum(increase(slot_event_dwell_seconds_sum{application=\"slot-service\"}[$__range])) / sum(increase(slot_event_dwell_seconds_count{application=\"slot-service\"}[$__range])))",
          "legendFormat": "비율",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
