          "expr": "histogram_quantile(0.5, sum by (le) (increase(slot_event_dwell_seconds_bucket{application=\"slot-service\"}[$__range])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
