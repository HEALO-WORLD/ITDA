          },
          "refId": "A",
          "expr": "sum by (application) (rate(spring_kafka_listener_seconds_sum{application=~\"$application\"}[$__rate_interval])) / sum by (application) (rate(spring_kafka_listener_seconds_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{application}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
