      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Consumer 처리 수 (msg/s)",
      "datasource": {
