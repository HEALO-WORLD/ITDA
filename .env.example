POSTGRES_USER=itda
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 서비스 접속 주소: 컨테이너·배포 환경에서만 주석을 풀고 설정한다
# 로컬 개발은 설정하지 않는다. 값을 비운 채(DB_HOST=)로 두면 기본값(localhost) 대신 빈 값이 들어가 접속에 실패한다
# DB_HOST=postgres
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# EUREKA_URL=http://eureka-server:8761/eureka/
# REDIS_HOST=redis

# Grafana 관리자 계정 비밀번호
GRAFANA_ADMIN_PASSWORD=

# JWT 토큰 서명 및 검증에 사용하는 비밀키
JWT_SECRET=

# 개발용 임시 토큰 발급 API 활성화 여부
# 로컬 테스트에서만 true로 설정한다.
# 배포 환경에서는 반드시 비활성화한다.
DEV_TOKEN_ENABLED=

# 로컬 개발용 초기 테스트 데이터 삽입 여부
# 로컬 환경에서 필요할 때만 always로 설정한다.
# 배포 환경에서는 데이터 중복 및 변경을 방지하기 위해 활성화하지 않는다.
SEED_ENABLED=

# Swagger UI 및 OpenAPI 문서 활성화 여부
# 개발 환경에서는 true로 설정할 수 있다.
# 배포 환경에서는 외부 문서 공개 정책에 따라 설정한다.
SWAGGER_ENABLED = true

# 재조정 기한 만료 스케줄러 활성화 여부
# true  : 기한이 지난 NEEDS_RESCHEDULE 의뢰를 자동 종료
# false : 자동 종료 기능 비활성화
# 운영 데이터에 영향을 주므로 대상 데이터 검증 후 활성화한다.
# 기본값은 false를 권장한다.
RESCHEDULE_EXPIRATION_SCHEDULER_ENABLED=true

# 재조정 기한 만료까지의 유예 시간 (단위: 시간)
# 기존 차단 예약의 검사 시작 시각과 차단 시각 중 늦은 시점부터 계산한다.
# 48 = 해당 기준 시각으로부터 48시간 경과 시 EXPIRED 처리
RESCHEDULE_EXPIRATION_GRACE_HOURS=48