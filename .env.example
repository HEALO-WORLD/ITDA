POSTGRES_USER=itda
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 서비스 접속 주소: 컨테이너·배포 환경에서만 주석을 풀고 설정한다
# 로컬 개발은 설정하지 않는다. 값을 비운 채(DB_HOST=)로 두면 기본값(localhost) 대신 빈 값이 들어가 접속에 실패한다
# DB_HOST=postgres
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# EUREKA_URL=http://eureka-server:8761/eureka/
# REDIS_HOST=redis

GRAFANA_ADMIN_PASSWORD=

JWT_SECRET=

# 개발용 임시 토큰 발급 API 활성화 (로컬에서만 true, 배포 환경에서는 설정하지 않음)
DEV_TOKEN_ENABLED=

# 로컬 개발용 seed 데이터 실행 (로컬에서만 always, 배포 환경에서는 설정하지 않음)
SEED_ENABLED=
